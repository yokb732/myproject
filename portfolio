<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Your Name — Portfolio</title>
  <meta name="description" content="Portfolio of Your Name — developer, designer, problem solver." />
  <link rel="stylesheet" href="styles.css" />
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <h1 class="brand">Your Name</h1>
      <nav class="nav" aria-label="Main navigation">
        <a href="#about">About</a>
        <a href="#projects">Projects</a>
        <a href="#contact">Contact</a>
        <a class="btn" id="resume-link" href="resume.pdf" download>Resume</a>
        <button id="color-toggle" aria-label="Toggle dark mode">🌙</button>
      </nav>
    </div>
  </header>

  <main>
    <section id="hero" class="hero container">
      <div class="hero-content">
        <p class="eyebrow">Hi, I'm</p>
        <h2>Your Name</h2>
        <p class="lead">I build fast, accessible, and maintainable web apps. I enjoy solving problems with simple, well-designed solutions.</p>
        <p>
          <a href="#projects" class="btn primary">See my work</a>
          <a href="#contact" class="btn">Get in touch</a>
        </p>
      </div>
      <div class="hero-image" aria-hidden="true">
        <!-- Placeholder illustration -->
        <svg width="260" height="160" viewBox="0 0 260 160" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="260" height="160" rx="10" fill="var(--muted)"/>
        </svg>
      </div>
    </section>

    <section id="about" class="container about">
      <h3>About</h3>
      <p>I’m a software developer focused on front-end architecture and UX. I care about performance, accessibility, and shipping quality code. I’ve worked on projects using JavaScript, TypeScript, Node, and modern frameworks.</p>
      <ul class="skills">
        <li>JavaScript / TypeScript</li>
        <li>HTML & CSS</li>
        <li>React / Vite</li>
        <li>Testing & CI</li>
      </ul>
    </section>

    <section id="projects" class="container projects">
      <h3>Projects</h3>
      <div id="project-grid" class="grid">
        <!-- Project cards rendered by script.js -->
      </div>
    </section>

    <section id="contact" class="container contact">
      <h3>Contact</h3>
      <p>If you'd like to work together or have questions, send me a message:</p>
      <form id="contact-form">
        <div class="field">
          <label for="name">Name</label>
          <input id="name" name="name" type="text" required />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required />
        </div>
        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5" required></textarea>
        </div>
        <button type="submit" class="btn primary">Send</button>
      </form>
      <p class="muted">Or email me at <a href="mailto:you@example.com">you@example.com</a></p>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container">
      <p>© <span id="year"></span> Your Name — Built with care.</p>
      <p class="muted">Designed for performance and accessibility.</p>
    </div>
  </footer>

  <script src="script.js" defer></script>
</body>
</html>
